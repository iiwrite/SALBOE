---
interface Props {
  href: string;
  image: string;
  imageAlt: string;
  title: string;
  headingLevel?: 'h3' | 'h4';
}

const { href, image, imageAlt, title, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<div class="poetry-item">
  <a href={href}>
    <img
      class="front-image"
      src={image}
      alt={imageAlt}
      loading="lazy"
      width="500"
      height="250"
    />
    <Heading>{title}</Heading>
  </a>
</div>
